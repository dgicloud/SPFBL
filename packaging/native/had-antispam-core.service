[Unit]
Description=HAD AntiSpam native SPFBL core
Wants=network-online.target
Requires=had-antispam-firewall.service
After=network-online.target had-antispam-firewall.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hadantispam
Group=hadantispam
WorkingDirectory=/opt/spfbl
Environment=HOME=/var/lib/had-antispam
UMask=0027
ExecStart=/usr/bin/java -Xms512m -Xmx2048m -cp /opt/spfbl/current/SPFBL.jar:/opt/spfbl/current/lib/* net.spfbl.core.Core
ExecStop=+/usr/bin/python3 /opt/spfbl/current/control.py shutdown
TimeoutStopSec=120
KillMode=mixed
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/had-antispam /var/log/had-antispam

[Install]
WantedBy=multi-user.target
