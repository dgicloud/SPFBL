[Unit]
Description=Persist SPFBL state through the local ADMIN socket
Requires=spamfox-core.service
After=spamfox-core.service

[Service]
Type=oneshot
User=spamfox
Group=spamfox
ExecStart=/usr/bin/python3 /opt/spfbl/current/control.py store
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
